// Keep one result per planned onset. Multiple possible attacks make a slot
// uncertain. An empty slot and extra attacks have their own report counters.
// in1 capture state, in2 guided stage, in3 mode, in4 event, in5 slot,
// in6 verdict, in7 deviation, in8 guide anchor after prompt ms,
// in9 possible attack pulse, in10 estimated deviation for that candidate.
Data counts(4);
Data verdicts(4);
Data deviations(4);
Data possibleCounts(4);
Data possibleDeviations(4);
History extras(0);
History possibleExtras(0);
History previousStage(0);

reset = (in2 == 1) && (previousStage != 1) && (in3 == 2);
nextExtras = extras;
nextPossibleExtras = possibleExtras;
if (reset) {
    nextExtras = 0;
    nextPossibleExtras = 0;
    for (i = 0; i < 4; i += 1) {
        poke(counts, 0, i);
        poke(verdicts, 0, i);
        poke(deviations, 0, i);
        poke(possibleCounts, 0, i);
        poke(possibleDeviations, 0, i);
    }
} else if (in4 == 1) {
    if ((in5 >= 1) && (in5 <= 4)) {
        index = in5 - 1;
        count = peek(counts, index);
        poke(counts, count + 1, index);
        poke(verdicts, count == 0 ? in6 : 1, index);
        poke(deviations, count == 0 ? in7 : 0, index);
    } else { nextExtras = extras + 1; }
} else if (in9 == 1) {
    if ((in5 >= 1) && (in5 <= 4)) {
        possibleIndex = in5 - 1;
        possibleCount = peek(possibleCounts, possibleIndex);
        poke(possibleCounts, possibleCount + 1, possibleIndex);
        poke(possibleDeviations, possibleCount == 0 ? in10 : 0, possibleIndex);
    } else { nextPossibleExtras = possibleExtras + 1; }
}

available = in1 == 5;
count0 = peek(counts, 0); count1 = peek(counts, 1);
count2 = peek(counts, 2); count3 = peek(counts, 3);
verdict0 = peek(verdicts, 0); verdict1 = peek(verdicts, 1);
verdict2 = peek(verdicts, 2); verdict3 = peek(verdicts, 3);
deviation0 = peek(deviations, 0); deviation1 = peek(deviations, 1);
deviation2 = peek(deviations, 2); deviation3 = peek(deviations, 3);
out1 = in1;
out2 = available ? nextExtras : 0;
out3 = available ? count0 : 0;
out4 = available ? count1 : 0;
out5 = available ? count2 : 0;
out6 = available ? count3 : 0;
out7 = available ? verdict0 : 0;
out8 = available ? verdict1 : 0;
out9 = available ? verdict2 : 0;
out10 = available ? verdict3 : 0;
out11 = available ? deviation0 : 0;
out12 = available ? deviation1 : 0;
out13 = available ? deviation2 : 0;
out14 = available ? deviation3 : 0;
out15 = available ? in8 : 0;
possible0 = peek(possibleCounts, 0); possible1 = peek(possibleCounts, 1);
possible2 = peek(possibleCounts, 2); possible3 = peek(possibleCounts, 3);
estimate0 = peek(possibleDeviations, 0); estimate1 = peek(possibleDeviations, 1);
estimate2 = peek(possibleDeviations, 2); estimate3 = peek(possibleDeviations, 3);
out16 = available ? nextPossibleExtras : 0;
out17 = available ? possible0 : 0;
out18 = available ? possible1 : 0;
out19 = available ? possible2 : 0;
out20 = available ? possible3 : 0;
out21 = available ? estimate0 : 0;
out22 = available ? estimate1 : 0;
out23 = available ? estimate2 : 0;
out24 = available ? estimate3 : 0;
showProgress = (in1 == 1) || (in1 == 2) || available;
singleMatches = (count0 == 1) + (count1 == 1) + (count2 == 1) + (count3 == 1);
out25 = showProgress ? singleMatches : -1;
out26 = showProgress && (nextPossibleExtras + possible0 + possible1 + possible2 + possible3 > 0);
extras = nextExtras;
possibleExtras = nextPossibleExtras;
previousStage = in2;
