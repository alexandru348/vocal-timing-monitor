// Schedule digital pulses from one host quarter boundary and sample count.
// in1 observed phase, in2 observed period ms, in3 clock sync, in4 clock ready.
// in5 preflight sample clock.
// out1 stage, out2 maximum clock disagreement ms, out3 analysis-only audio.
// out4 rising edge of actual audio, out5 current sample clock in ms.
Param request(0);
History lastRequest(0);
History stage(0);
History elapsed(0);
History waitSamples(0);
History maximumError(0);
History previousActive(0);

samplesPerBeat = samplerate * 0.6;
newTest = request != lastRequest;
correctTempo = abs(in2 - 600) <= 0.12;
// Native clock recovery may extend 10 ms past an endpoint hold. Use the
// first clean phase near the boundary and backdate it by the observed phase.
anchor = (in1 >= 0) && (in1 <= 0.04) && (in4 == 1) && correctTempo;
phaseDistance = in1 - elapsed / samplesPerBeat;
phaseError = abs(phaseDistance - floor(phaseDistance + 0.5)) * 600;
nextStage = stage;
nextElapsed = elapsed;
nextWait = waitSamples;
nextError = maximumError;

if (newTest) {
    nextStage = 1;
    nextWait = 0;
    nextError = 0;
} else if (stage == 1) {
    nextWait = waitSamples + 1;
    if (anchor) {
        nextStage = 2;
        nextElapsed = floor(in1 * samplesPerBeat + 0.5) + 1;
    } else if (nextWait >= 3 * samplerate) {
        nextStage = 6;
    }
} else if ((stage == 2) || (stage == 3)) {
    nextElapsed = elapsed + 1;
    nextError = max(maximumError, phaseError);
    if ((in3 != 1) || !correctTempo || (phaseError > 4)) {
        nextStage = 6;
    } else if (elapsed >= 5.4 * samplerate) {
        nextStage = 5;
    } else if (elapsed >= 1.25 * samplerate) {
        nextStage = 3;
    }
}

// Absolute times from the anchor for beats 3..8 with offsets -150, 0,
// +150 ms (twice) plus a known 90 ms delay. Explicit positions avoid floor
// on a quotient at an exact boundary in the native DSP compiler.
pulse1 = floor(1.740 * samplerate + 0.5);
pulse2 = floor(2.490 * samplerate + 0.5);
pulse3 = floor(3.240 * samplerate + 0.5);
pulse4 = floor(3.540 * samplerate + 0.5);
pulse5 = floor(4.290 * samplerate + 0.5);
pulse6 = floor(5.040 * samplerate + 0.5);
audio = 0;
active = 0;
if (nextStage == 3) {
    start = pulse1;
    if (elapsed >= pulse6) { start = pulse6; }
    else if (elapsed >= pulse5) { start = pulse5; }
    else if (elapsed >= pulse4) { start = pulse4; }
    else if (elapsed >= pulse3) { start = pulse3; }
    else if (elapsed >= pulse2) { start = pulse2; }
    since = elapsed - start;
    active = (since >= 0) && (since < 0.04 * samplerate);
    if (active) {
        cycle = since * 1000 / samplerate;
        audio = cycle - floor(cycle) < 0.5 ? 0.24 : -0.24;
    }
}

out1 = nextStage;
out2 = nextError;
out3 = audio;
out4 = active && !previousActive;
out5 = in5 * 1000 / samplerate;
lastRequest = request;
stage = nextStage;
elapsed = nextElapsed;
waitSamples = nextWait;
maximumError = nextError;
previousActive = active;
