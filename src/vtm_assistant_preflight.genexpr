nmaxendpointlength = max(maxendpointlength, nlastendpointlength);
nlastendpointresumephase = endpointresume ? in5 : lastendpointresumephase;
nlastendpointresumeinc = endpointresume ? inc : lastendpointresumeinc;
nendpointcatchups = min(1000000000, endpointcatchups + endpointcatchup);
nendpointresumerejections = min(1000000000, endpointresumerejections + (endpointresume && !progressok));
nlastendpointexpectedinc = endpointresume ? expectedendpointinc : lastendpointexpectedinc;
nlastendpointerrorsamples = endpointresume ? (inc * periodms * samplerate / 1000 - (endpointrun + 1)) : lastendpointerrorsamples;
