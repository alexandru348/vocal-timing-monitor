reviewconflict = (sourcemode == 2) && recordactive;
evaluatepermit = detectpermit && timingready && timingok && (quality == 1) && micpresent && refpresent && !reviewconflict;

// Stable reason priority; levels are evidence of SIGNAL, not detected singing.
state = 0;
if (enabled != 1) { state = 0; }
else if (deviceon != 1) { state = 1; }
else if ((apiready != 1) || !fresh || !hostknown) { state = 2; }
else if (countingin == 1) { state = 4; }
else if (playing == 0) { state = 3; }
else if (!synced || !tempoquiet || boundary || !timingready) { state = 5; }
else if (!sourceknown || (voicebinding != 1)) { state = 6; }
else if (referencebinding != 1) { state = 7; }
else if (!timingok) { state = 8; }
else if (nmicclip > 0) { state = 9; }
else if (nrefclip > 0) { state = 10; }
else if (quality != 1) { state = 11; }
else if (reviewconflict) { state = 17; }
else if (!refpresent) { state = 12; }
else if (!micpresent) { state = 13; }
else if (sourcemode == 2) { state = 16; }
else if (recordactive) { state = 14; }
else { state = 15; }

corrected = phase - appliedoffset / max(1, nperiod);
wrapped = corrected - floor(corrected);
out1 = state;
out2 = detectpermit;
out3 = evaluatepermit;
out4 = phase;
out5 = evaluatepermit ? wrapped : 0;
out6 = nperiod;
out7 = micpresent;
out8 = refpresent;
out9 = clips;
out10 = nepoch;
out11 = clock;
out12 = timingok ? appliedoffset : 0;
out13 = synced;
// A recovery may replace the last boundary, so preserve the falling-permission
