out16 = ncontrolchanges;
out17 = nhostchanges;
out18 = nsourcechanges;
out19 = ntimingchanges;
out20 = nresetchanges;
out21 = nfreshchanges;
out22 = nsyncchanges;
out23 = nclipchanges;
out24 = nperiodchanges;
