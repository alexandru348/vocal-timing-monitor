}
micpresent = nmichold > 0;
refpresent = nrefhold > 0;
transportcontext = (enabled == 1) && (deviceon == 1) && (apiready == 1) && fresh && hostknown && (playing == 1) && (countingin == 0) && synced && tempoquiet && sourceknown && bindingsok;
contextok = transportcontext && !boundary;
detectpermit = contextok && (clips == 0);
// Recorded-voice review never pretends that a currently recording input is
