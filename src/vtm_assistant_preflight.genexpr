nphasesum = progressok && !endpointcatchup ? phasesum + inc : 0;
windowready = nphasecount >= max(1, floor(samplerate * 0.010));
windowperiod = nphasecount > 0 ? 1000 * nphasecount / (max(0.000000000001, nphasesum) * samplerate) : periodms;
nperiodvalid = endpointbridge ? periodvalid : (!progressok ? 0 : (windowready ? ((windowperiod >= 60000.0 / 404.0) && (windowperiod <= 60000.0 / 19.8)) : periodvalid));
clockok = (progressok || endpointgrace) && nperiodvalid;
nvalid = endpointbridge ? validrun : (clockok ? min(validrun + 1, samplerate) : 0);
synced = nvalid >= samplerate * 0.010;
// No phase-based evaluation on a duplicate or before 10 ms clean recovery.
timingready = synced && progressok && (nendpointclean >= samplerate * 0.010);
nperiod = windowready && clockok ? windowperiod : periodms;
// Lease requires a positive, changing caller poll token, not just stale flags.
nage = (hostseq > 0) && (hostseq != lastseq) ? 0 : min(leaseage + 1, 1000000000);
fresh = (hostseq > 0) && (nage < samplerate * 0.250);
hostknown = ((playing == 0) || (playing == 1)) && ((countingin == 0) || (countingin == 1)) && ((recording == 0) || (recording == 1)) && ((sessionrecord == 0) || (sessionrecord == 1)) && ((sessionstatus == 0) || (sessionstatus == 1) || (sessionstatus == 2));
recordactive = (recording == 1) || (sessionrecord == 1) || (sessionstatus > 0);
sourceknown = (sourcemode == 1) || (sourcemode == 2);
// Binding 1 = unambiguous accepted source; 0 unknown; 2 ambiguous.
bindingsok = (voicebinding == 1) && (referencebinding == 1);
// Policy 1 applies calibrated offset once. Policy 2 bypasses it only for a
