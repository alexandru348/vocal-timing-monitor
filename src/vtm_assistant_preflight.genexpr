Param deviceon(1);
Param apiready(0);
Param hostseq(0);
Param playing(-1);
Param countingin(-1);
Param recording(-1);
Param sessionrecord(-1);
Param sessionstatus(-1);
Param sourcemode(0);
Param voicebinding(0);
Param referencebinding(0);
Param quality(0);
Param timingpolicy(0);
Param calibrationvalid(0);
Param audiorevision(0);
Param calibratedrevision(-1);
Param timelinevalid(0);
Param timelinerevision(-1);
Param positionseq(0);
Param offsetms(0);
Param micfloor(0.004);
Param reffloor(0.0001);
Param resetseq(0);
