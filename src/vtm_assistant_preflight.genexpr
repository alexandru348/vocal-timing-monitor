calok = (calibrationvalid == 1) && (calibratedrevision == audiorevision) && (audiorevision > 0) && (offsetms >= -500) && (offsetms <= 500);
timelineok = (sourcemode == 2) && (timelinevalid == 1) && (audiorevision > 0) && (timelinerevision == audiorevision);
timingok = ((timingpolicy == 1) && calok) || ((timingpolicy == 2) && timelineok);
appliedoffset = (timingpolicy == 1) && calok ? offsetms : 0;
// Phase-offset conversion assumes locally stable tempo. Suspend after a
// meaningful period change; long offsets require a correspondingly long hold.
periodshift = windowready && clockok && (abs(nperiod - stableperiod) > max(0.01, stableperiod * 0.0001));
nstableperiod = periodshift ? nperiod : stableperiod;
ntempoage = (!synced || periodshift) ? 0 : min(tempoage + 1, samplerate * 2);
tempoquiet = ntempoage >= samplerate * max(0.050, abs(appliedoffset) / 1000);

// Short holds tolerate gaps, without interpreting silence as a rhythm error.
miclevel = max(abs(in1), abs(in2));
reflevel = max(abs(in3), abs(in4));
miccoef = exp(-1 / (samplerate * (miclevel > micenv ? 0.002 : 0.020)));
refcoef = exp(-1 / (samplerate * (reflevel > refenv ? 0.002 : 0.020)));
nmicenv = miclevel + miccoef * (micenv - miclevel);
nrefenv = reflevel + refcoef * (refenv - reflevel);
nmichold = nmicenv >= clamp(micfloor, 0.0001, 0.5) ? samplerate * 0.100 : max(0, michold - 1);
nrefhold = nrefenv >= clamp(reffloor, 0.00001, 0.5) ? samplerate * 0.400 : max(0, refhold - 1);
// The microphone can peak near full scale without overloading. Include
