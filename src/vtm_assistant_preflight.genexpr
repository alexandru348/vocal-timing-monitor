nboundarymask = boundary ? boundarymask : lastboundarymask;
nboundarytime = boundary ? clock : lastboundarytime;
ncontrolchanges = min(1000000000, controlchanges + controlchange);
nhostchanges = min(1000000000, hostchanges + hostchange);
nsourcechanges = min(1000000000, sourcechanges + sourcechange);
ntimingchanges = min(1000000000, timingchanges + timingchange);
nresetchanges = min(1000000000, resetchanges + resetchange);
nfreshchanges = min(1000000000, freshchanges + (fresh != prevfresh));
nsyncchanges = min(1000000000, syncchanges + (synced != prevsync));
nclipchanges = min(1000000000, clipchanges + (clips != prevclips));
nperiodchanges = min(1000000000, periodchanges + periodshift);
