micatlimit = miclevel >= 0.9999;
refatlimit = reflevel >= 0.98;
nmicclip = micatlimit ? samplerate * 0.020 : max(0, miccliphold - 1);
nrefclip = refatlimit ? samplerate * 0.250 : max(0, refcliphold - 1);
controlchange = (enabled != prevenabled) || (deviceon != prevdeviceon) || (apiready != prevapi) || (quality != prevquality) || (micfloor != prevmicfloor) || (reffloor != prevreffloor);
hostchange = (playing != prevplaying) || (countingin != prevcountingin) || (recording != prevrecording) || (sessionrecord != prevsessionrecord) || (sessionstatus != prevsessionstatus);
sourcechange = (sourcemode != prevsource) || (voicebinding != prevvoice) || (referencebinding != prevreference) || (audiorevision != prevaudiorevision);
timingchange = (timingpolicy != prevpolicy) || (calibrationvalid != prevcalvalid) || (calibratedrevision != prevcalibratedrevision) || (timelinevalid != prevtimeline) || (timelinerevision != prevtimelinerevision) || (offsetms != prevoffset);
resetchange = (positionseq != prevpositionseq) || (resetseq != lastreset);
configchanged = controlchange || hostchange || sourcechange || timingchange || resetchange;
clips = (nmicclip > 0) + 2 * (nrefclip > 0);
nonclipboundary = configchanged || (fresh != prevfresh) || (synced != prevsync) || periodshift || (tempoquiet != prevtempoquiet);
clipboundary = clips != prevclips;
boundary = nonclipboundary || clipboundary;
boundarymask = 1 * controlchange + 2 * hostchange + 4 * sourcechange + 8 * timingchange + 16 * resetchange + 32 * (fresh != prevfresh) + 64 * (synced != prevsync) + 128 * (clips != prevclips) + 256 * periodshift + 512 * (tempoquiet != prevtempoquiet);
nepoch = epoch + boundary;
if (boundary) {
