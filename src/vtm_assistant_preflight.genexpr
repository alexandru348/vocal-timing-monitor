permitmask = (enabled != 1) + 2 * (deviceon != 1) + 4 * (apiready != 1) + 8 * (!fresh) + 16 * (!hostknown) + 32 * (playing != 1) + 64 * (countingin != 0) + 128 * (!synced) + 256 * (!tempoquiet) + 512 * (!sourceknown) + 1024 * (!bindingsok) + 2048 * boundary + 4096 * (clips != 0);
