validrun = nvalid;
periodms = nperiod;
phasecount = windowready ? 0 : nphasecount;
phasesum = windowready ? 0 : nphasesum;
periodvalid = nperiodvalid;
stableperiod = nstableperiod;
tempoage = ntempoage;
