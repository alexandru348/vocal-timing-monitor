nlastrecoverytime = clockfault ? 0 : ((faultactive && progressok) ? clock : lastrecoverytime);
nfaultactive = clockfault ? !progressok : (faultactive && !progressok);
nlastfaultplaying = clockfault ? playing : lastfaultplaying;
nlastfaultcountingin = clockfault ? countingin : lastfaultcountingin;
out33 = nclockfaults;
out34 = nlastfaultmask;
out35 = nlastfaultprevious;
out36 = nlastfaultphase;
out37 = nlastfaultinc;
out38 = nlastfaultperiod;
out39 = 1000 * nlastfaulttime / samplerate;
out40 = nlastfaultlength;
out41 = nmaxfaultlength;
out42 = nlastrecoveryinc;
out43 = nlastfaultplaying;
out44 = nlastfaultcountingin;
out45 = 1000 * nlastrecoverytime / samplerate;
out46 = endpointgrace;
out47 = nendpointepisodes;
out48 = nendpointrecoveries;
out49 = nlastendpointlength;
out50 = nmaxendpointlength;
out51 = timingready;
out52 = nlastendpointresumephase;
out53 = nlastendpointresumeinc;
out54 = nendpointcatchups;
out55 = nendpointresumerejections;
