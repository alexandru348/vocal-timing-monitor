out1 = nst;
out2 = nresult;
out3 = nquality;
out4 = ns > 0;
out5 = requestseq;
// Read-only diagnostics; candidate is never an accepted compensation.
out6 = nreject;
out7 = ndlag;
out8 = nda;
out9 = ndb;
out10 = ndmargin;
out11 = nddiff;
out12 = nconfirmed;
out13 = nspread;

lastrequest = requestseq; lastcancel = cancelseq; lastsr = samplerate;
prevphase = phase; validrun = nv;
clocklocked = nclocklocked; clockbad = nclockbad; clockinc = nclockinc;
stage = ns; state = nst;
clock = nc; ticks = nt; count = nn; msum = nm; rsum = nr;
menv = me; renv = re;
mlprev = in1; mrprev = in2; rlprev = in3; rrprev = in4;
mlhp = am; mrhp = bm; rlhp = ar; rrhp = br;
lagindex = li; pos = pp;
sx = ax; sy = ay; sxx = axx; syy = ayy; sxy = axy;
tx = bx; ty = by; txx = bxx; tyy = byy; txy = bxy;
best = nbest; bestlag = nlag; besta = na; bestb = nb; laga = nla; lagb = nlb;
runner = nrunner; scan = nscan; resultms = nresult; quality = nquality;

