    for (q = 0; q < 64; q += 1) {
        if (nscan < 801) {
            value = peek(scores, nscan);
            if ((abs(nscan - nlag) > 20) && (value > nrunner)) { nrunner = value; }
            nscan = nscan + 1;
        }
    }
    if (nscan >= 801) {
        nquality = max(0, min(1, nbest));
        accepted = (nbest >= 0.85) && ((nbest - nrunner) >= 0.12) && (abs(nla - nlb) <= 3) && (nlag > 2) && (nlag < 798);
        // Each band keeps the previous strict single-band acceptance checks.
        nreject = !nrefviable ? 1 : (!nmicviable ? 2 : (nbest < 0.85 ? 3 : ((nbest - nrunner) < 0.12 ? 4 : (abs(nla - nlb) > 3 ? 5 : ((nlag <= 2) || (nlag >= 798) ? 6 : 0)))));
        estimate = nlag - 400;
        if (accepted) {
            left = peek(scores, nlag - 1);
            right = peek(scores, nlag + 1);
            bend = left - 2 * nbest + right;
            fraction = abs(bend) > 0.00000001 ? clamp(0.5 * (left - right) / bend, -0.5, 0.5) : 0;
            estimate = estimate + fraction;
        }
        // Store per-band evidence before reusing the bounded correlation workspace.
        poke(bandinfo, accepted, nbi * 10);
        poke(bandinfo, estimate, nbi * 10 + 1);
        poke(bandinfo, nbest, nbi * 10 + 2);
        poke(bandinfo, nlag - 400, nbi * 10 + 3);
        poke(bandinfo, na, nbi * 10 + 4);
        poke(bandinfo, nb, nbi * 10 + 5);
        poke(bandinfo, nbest - nrunner, nbi * 10 + 6);
        poke(bandinfo, abs(nla - nlb), nbi * 10 + 7);
        poke(bandinfo, nreject, nbi * 10 + 8);
        nbi = nbi + 1;
        if (nbi < 4) {
            ns = 2; nst = 2;
            li = 0; pp = 0;
            nbest = -1; nlag = 0; na = -1; nb = -1; nla = 0; nlb = 0;
            nrunner = -1; nscan = 0; nrefviable = 0; nmicviable = 0;
        } else {
            ns = 4;
        }
    }
} else if (ns == 4) {
    // Require at least two individually conclusive bands and agreement of ALL
    // conclusive bands. Do not cherry-pick a cluster or accept a lone best lag.
    nconfirmed = 0; minlag = 1000; maxlag = -1000;
    bestquality = -2; bestvalidquality = -2; chosen = 0; chosenvalid = 0;
    for (q = 0; q < 4; q += 1) {
        pass = peek(bandinfo, q * 10);
        candidatequality = peek(bandinfo, q * 10 + 2);
        if (candidatequality > bestquality) { bestquality = candidatequality; chosen = q; }
        if (pass > 0) {
            nconfirmed = nconfirmed + 1;
            candidate = peek(bandinfo, q * 10 + 1);
            minlag = min(minlag, candidate); maxlag = max(maxlag, candidate);
            if (candidatequality > bestvalidquality) { bestvalidquality = candidatequality; chosenvalid = q; }
        }
    }
    if (nconfirmed > 0) { chosen = chosenvalid; }
    nspread = nconfirmed > 1 ? maxlag - minlag : 0;
    nquality = clamp(peek(bandinfo, chosen * 10 + 2), 0, 1);
    ndlag = peek(bandinfo, chosen * 10 + 3);
    nda = peek(bandinfo, chosen * 10 + 4); ndb = peek(bandinfo, chosen * 10 + 5);
    ndmargin = peek(bandinfo, chosen * 10 + 6); nddiff = peek(bandinfo, chosen * 10 + 7);
    nreject = peek(bandinfo, chosen * 10 + 8);
    ns = 0;
    if (nround > 0) {
        // Independent new acquisition: the SAME band must qualify again.
        // All conclusive second-capture paths and the first estimate must agree.
        anchorpass = peek(bandinfo, nanchorband * 10);
        anchorsecond = peek(bandinfo, nanchorband * 10 + 1);
        totalspread = max(maxlag, nanchorlag) - min(minlag, nanchorlag);
        if ((anchorpass > 0) && (nconfirmed > 0) && (totalspread <= 3)) {
            nresult = 0.5 * (nanchorlag + anchorsecond);
            nquality = min(nanchorquality, clamp(peek(bandinfo, nanchorband * 10 + 2), 0, 1));
            nst = 3; nreject = 0; nspread = totalspread;
        } else {
            nst = 4;
            nreject = 9;
            if ((nconfirmed >= 2) && (nspread > 3)) { nreject = 8; }
            if ((anchorpass > 0) && (abs(anchorsecond - nanchorlag) > 3)) { nreject = 10; nspread = totalspread; }
        }
    } else if ((nconfirmed >= 2) && (nspread <= 3)) {
        nresult = peek(bandinfo, chosen * 10 + 1); nst = 3; nreject = 0;
    } else if (nconfirmed == 1) {
        // A lone band is provisional, never an immediate compensation.
        // Reuse the fixed buffers only after a completely new 3.584 s capture.
        nround = 1; nanchorband = chosen;
        nanchorlag = peek(bandinfo, chosen * 10 + 1);
        nanchorquality = peek(bandinfo, chosen * 10 + 2);
        ns = 1; nst = 7; nquality = 0; nreject = 0; nbi = 0;
        nc = 0; nt = 0; nn = 0; nm = 0; nr = 0;
        b1nm = 0; b1nr = 0; b2nm = 0; b2nr = 0; b3nm = 0; b3nr = 0;
        li = 0; pp = 0;
        ax = 0; ay = 0; axx = 0; ayy = 0; axy = 0;
        bx = 0; by = 0; bxx = 0; byy = 0; bxy = 0;
        nbest = -1; nlag = 0; na = -1; nb = -1; nla = 0; nlb = 0;
        nrunner = -1; nscan = 0; nrefviable = 0; nmicviable = 0;
    } else {
        nst = 4;
