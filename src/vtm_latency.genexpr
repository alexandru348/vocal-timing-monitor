// Three matched, overlapping bands reduce dependence on broad spectral balance.
// Each has cascaded first-order high-pass and low-pass stages on both paths.
b1hp = exp(-6.28318530718 * 250 / samplerate);
b1lp = exp(-6.28318530718 * 700 / samplerate);
b1mlh1 = in1 - b1mlprev + b1hp * b1mlhp1;
b1mlh2 = b1mlh1 - b1mlhp1 + b1hp * b1mlhp2;
b1mll1 = (1 - b1lp) * b1mlh2 + b1lp * b1mllp1;
b1mll2 = (1 - b1lp) * b1mll1 + b1lp * b1mllp2;
b1mrh1 = in2 - b1mrprev + b1hp * b1mrhp1;
b1mrh2 = b1mrh1 - b1mrhp1 + b1hp * b1mrhp2;
b1mrl1 = (1 - b1lp) * b1mrh2 + b1lp * b1mrlp1;
b1mrl2 = (1 - b1lp) * b1mrl1 + b1lp * b1mrlp2;
b1rlh1 = in3 - b1rlprev + b1hp * b1rlhp1;
b1rlh2 = b1rlh1 - b1rlhp1 + b1hp * b1rlhp2;
b1rll1 = (1 - b1lp) * b1rlh2 + b1lp * b1rllp1;
b1rll2 = (1 - b1lp) * b1rll1 + b1lp * b1rllp2;
b1rrh1 = in4 - b1rrprev + b1hp * b1rrhp1;
b1rrh2 = b1rrh1 - b1rrhp1 + b1hp * b1rrhp2;
b1rrl1 = (1 - b1lp) * b1rrh2 + b1lp * b1rrlp1;
b1rrl2 = (1 - b1lp) * b1rrl1 + b1lp * b1rrlp2;
b1me = max(abs(b1mll2), abs(b1mrl2)) + coef * (b1menv - max(abs(b1mll2), abs(b1mrl2)));
b1re = max(abs(b1rll2), abs(b1rrl2)) + coef * (b1renv - max(abs(b1rll2), abs(b1rrl2)));
b1nm = b1msum; b1nr = b1rsum;
b2hp = exp(-6.28318530718 * 700 / samplerate);
b2lp = exp(-6.28318530718 * 2000 / samplerate);
b2mlh1 = in1 - b2mlprev + b2hp * b2mlhp1;
b2mlh2 = b2mlh1 - b2mlhp1 + b2hp * b2mlhp2;
b2mll1 = (1 - b2lp) * b2mlh2 + b2lp * b2mllp1;
b2mll2 = (1 - b2lp) * b2mll1 + b2lp * b2mllp2;
b2mrh1 = in2 - b2mrprev + b2hp * b2mrhp1;
b2mrh2 = b2mrh1 - b2mrhp1 + b2hp * b2mrhp2;
b2mrl1 = (1 - b2lp) * b2mrh2 + b2lp * b2mrlp1;
b2mrl2 = (1 - b2lp) * b2mrl1 + b2lp * b2mrlp2;
b2rlh1 = in3 - b2rlprev + b2hp * b2rlhp1;
b2rlh2 = b2rlh1 - b2rlhp1 + b2hp * b2rlhp2;
b2rll1 = (1 - b2lp) * b2rlh2 + b2lp * b2rllp1;
b2rll2 = (1 - b2lp) * b2rll1 + b2lp * b2rllp2;
b2rrh1 = in4 - b2rrprev + b2hp * b2rrhp1;
b2rrh2 = b2rrh1 - b2rrhp1 + b2hp * b2rrhp2;
b2rrl1 = (1 - b2lp) * b2rrh2 + b2lp * b2rrlp1;
b2rrl2 = (1 - b2lp) * b2rrl1 + b2lp * b2rrlp2;
b2me = max(abs(b2mll2), abs(b2mrl2)) + coef * (b2menv - max(abs(b2mll2), abs(b2mrl2)));
b2re = max(abs(b2rll2), abs(b2rrl2)) + coef * (b2renv - max(abs(b2rll2), abs(b2rrl2)));
b2nm = b2msum; b2nr = b2rsum;
b3hp = exp(-6.28318530718 * 2000 / samplerate);
b3lp = exp(-6.28318530718 * 6000 / samplerate);
b3mlh1 = in1 - b3mlprev + b3hp * b3mlhp1;
b3mlh2 = b3mlh1 - b3mlhp1 + b3hp * b3mlhp2;
b3mll1 = (1 - b3lp) * b3mlh2 + b3lp * b3mllp1;
b3mll2 = (1 - b3lp) * b3mll1 + b3lp * b3mllp2;
b3mrh1 = in2 - b3mrprev + b3hp * b3mrhp1;
b3mrh2 = b3mrh1 - b3mrhp1 + b3hp * b3mrhp2;
b3mrl1 = (1 - b3lp) * b3mrh2 + b3lp * b3mrlp1;
b3mrl2 = (1 - b3lp) * b3mrl1 + b3lp * b3mrlp2;
b3rlh1 = in3 - b3rlprev + b3hp * b3rlhp1;
b3rlh2 = b3rlh1 - b3rlhp1 + b3hp * b3rlhp2;
b3rll1 = (1 - b3lp) * b3rlh2 + b3lp * b3rllp1;
b3rll2 = (1 - b3lp) * b3rll1 + b3lp * b3rllp2;
b3rrh1 = in4 - b3rrprev + b3hp * b3rrhp1;
b3rrh2 = b3rrh1 - b3rrhp1 + b3hp * b3rrhp2;
b3rrl1 = (1 - b3lp) * b3rrh2 + b3lp * b3rrlp1;
b3rrl2 = (1 - b3lp) * b3rrl1 + b3lp * b3rrlp2;
b3me = max(abs(b3mll2), abs(b3mrl2)) + coef * (b3menv - max(abs(b3mll2), abs(b3mrl2)));
b3re = max(abs(b3rll2), abs(b3rrl2)) + coef * (b3renv - max(abs(b3rll2), abs(b3rrl2)));
b3nm = b3msum; b3nr = b3rsum;

request = requestseq != lastrequest;
cancel = (cancelseq != lastcancel) || ((lastsr > 0) && (samplerate != lastsr));
if (request) {
    ns = 0; nbi = 0; nconfirmed = 0; nspread = 0; nround = 0; nanchorlag = 0; nanchorband = 0; nanchorquality = 0;
    nquality = 0; nreject = 0; nrefviable = 0; nmicviable = 0;
    if ((permit > 0) && synced && !cancel) {
        ns = 1; nst = 1;
        nc = 0; nt = 0; nn = 0; nm = 0; nr = 0;
        li = 0; pp = 0;
        b1nm = 0; b1nr = 0;
        b2nm = 0; b2nr = 0;
        b3nm = 0; b3nr = 0;

        ax = 0; ay = 0; axx = 0; ayy = 0; axy = 0;
        bx = 0; by = 0; bxx = 0; byy = 0; bxy = 0;
        nbest = -1; nlag = 0; na = -1; nb = -1; nla = 0; nlb = 0;
        nrunner = -1; nscan = 0;
    } else {
        nst = 6;
    }
}
if ((ns > 0) && ((permit <= 0) || !synced || cancel)) {
    ns = 0; nst = 5; nquality = 0;
    // Latch the failure cause in the terminal packet; later guard recovery or
    // repeated polling must not erase the explanation.
    nreject = 100 + cancelreason;
    if ((permit <= 0) && ((cancelseq == lastcancel) || (cancelreason == 14))) { nreject = 200 + guardreason; }
    if (!synced) { nreject = hardjump ? 303 : 302; }
    if ((lastsr > 0) && (samplerate != lastsr)) { nreject = 301; }
}

if (ns == 1) {
    // Average at a rational 1 kHz clock: valid at 44.1, 48 and 96 kHz.
    nc = nc + 1000;
    nt = nt + 1;
    nm = nm + me;
    nr = nr + re;
    b1nm = b1nm + b1me; b1nr = b1nr + b1re;
    b2nm = b2nm + b2me; b2nr = b2nr + b2re;
    b3nm = b3nm + b3me; b3nr = b3nr + b3re;

    if (nc >= samplerate) {
        nc = nc - samplerate;
        poke(micdata, nm / nt, nn);
        poke(refdata, nr / nt, nn);
        poke(micdata, b1nm / nt, 1 * 3584 + nn);
        poke(refdata, b1nr / nt, 1 * 3584 + nn);
        b1nm = 0; b1nr = 0;
        poke(micdata, b2nm / nt, 2 * 3584 + nn);
        poke(refdata, b2nr / nt, 2 * 3584 + nn);
        b2nm = 0; b2nr = 0;
        poke(micdata, b3nm / nt, 3 * 3584 + nn);
        poke(refdata, b3nr / nt, 3 * 3584 + nn);
        b3nm = 0; b3nr = 0;

        nn = nn + 1; nt = 0; nm = 0; nr = 0;
        if (nn >= 3584) {
            ns = 2; nst = 2;
        }
    }
} else if (ns == 2) {
    // Bounded work: 64 multiply/accumulate iterations per audio sample.
    // Independent 1024 ms windows must agree on the same delay.
    for (q = 0; q < 64; q += 1) {
        if (pp < 2048) {
            idx = pp < 1024 ? 512 + pp : 2048 + pp - 1024;
            x = peek(refdata, nbi * 3584 + idx);
            y = peek(micdata, nbi * 3584 + idx + li - 400);
            if (pp < 1024) {
                ax = ax + x; ay = ay + y;
                axx = axx + x*x; ayy = ayy + y*y; axy = axy + x*y;
            } else {
                bx = bx + x; by = by + y;
                bxx = bxx + x*x; byy = byy + y*y; bxy = bxy + x*y;
            }
            pp = pp + 1;
        }
    }
    if (pp >= 2048) {
        vx = max(0, axx - ax*ax/1024);
        vy = max(0, ayy - ay*ay/1024);
        wx = max(0, bxx - bx*bx/1024);
        wy = max(0, byy - by*by/1024);
        nrefviable = max(nrefviable, (vx > 0.00000001) && (wx > 0.00000001));
        nmicviable = max(nmicviable, (vy > 0.00000001) && (wy > 0.00000001));
        ca = (vx > 0.00000001) && (vy > 0.00000001) ? (axy - ax*ay/1024) / sqrt(max(0.0000000000000001, vx*vy)) : -1;
        cb = (wx > 0.00000001) && (wy > 0.00000001) ? (bxy - bx*by/1024) / sqrt(max(0.0000000000000001, wx*wy)) : -1;
        score = min(ca, cb);
        poke(scores, score, li);
        if (score > nbest) { nbest = score; nlag = li; }
        if (ca > na) { na = ca; nla = li; }
        if (cb > nb) { nb = cb; nlb = li; }
        li = li + 1;
        pp = 0;
        ax = 0; ay = 0; axx = 0; ayy = 0; axy = 0;
        bx = 0; by = 0; bxx = 0; byy = 0; bxy = 0;
