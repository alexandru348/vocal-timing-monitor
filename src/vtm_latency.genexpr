phase = clamp(in5, 0, 1);
pd = phase - prevphase;
inc = pd < -0.5 ? pd + 1 : pd;
incok = (inc >= 19.8 / (60 * samplerate)) && (inc <= 404 / (60 * samplerate));
nv = incok ? min(validrun + 1, samplerate) : 0;
// Calibration timestamps use audio sample counts, not beat phase. Require
// initial lock, but tolerate <2 ms of invalid phase increments after lock.
// A large phase discontinuity still cancels immediately.
nclockbad = incok ? 0 : min(clockbad + 1, samplerate);
nclockinc = incok ? (clockinc > 0 ? clockinc + (inc - clockinc) / (samplerate * 0.1) : inc) : clockinc;
jumpthreshold = max(clockinc, 19.8 / (60 * samplerate)) * samplerate * 0.002;
hardjump = (clocklocked > 0) && (abs(inc) > jumpthreshold);
nclocklocked = (clocklocked > 0) || (nv >= samplerate * 0.010);
if (hardjump || (nclockbad >= samplerate * 0.002)) { nclocklocked = 0; }
synced = nclocklocked > 0;
ns = stage;
nst = state;
nc = clock;
nt = ticks;
nn = count;
nm = msum;
nr = rsum;
li = lagindex;
pp = pos;
ax = sx; ay = sy; axx = sxx; ayy = syy; axy = sxy;
bx = tx; by = ty; bxx = txx; byy = tyy; bxy = txy;
nbest = best; nlag = bestlag;
na = besta; nb = bestb; nla = laga; nlb = lagb;
nrunner = runner; nscan = scan;
nresult = resultms;
nquality = quality;
nreject = rejection;
nrefviable = refviable;
nmicviable = micviable;
nbi = bandindex;
nround = confirmationround; nanchorlag = anchorlag; nanchorband = anchorband; nanchorquality = anchorquality;
ndlag = diagnosticlag; nda = diagnostica; ndb = diagnosticb;
ndmargin = diagnosticmargin; nddiff = diagnosticdiff;
nconfirmed = confirmedbands; nspread = bandspread;

// Matched 65 Hz high-pass and 4 ms energy envelopes on both reference paths.
hp = exp(-6.28318530718 * 65 / samplerate);
am = in1 - mlprev + hp * mlhp;
bm = in2 - mrprev + hp * mrhp;
ar = in3 - rlprev + hp * rlhp;
br = in4 - rrprev + hp * rrhp;
coef = exp(-1 / (samplerate * 0.004));
me = max(abs(am), abs(bm)) + coef * (menv - max(abs(am), abs(bm)));
