    poke(rleft1, nrlframe1 / nframesamples, writepos);
    poke(rleft2, nrlframe2 / nframesamples, writepos);
    poke(rright0, nrrframe0 / nframesamples, writepos);
    poke(rright1, nrrframe1 / nframesamples, writepos);
    poke(rright2, nrrframe2 / nframesamples, writepos);
    poke(rmono0, nrmframe0 / nframesamples, writepos);
    poke(rmono1, nrmframe1 / nframesamples, writepos);
    poke(rmono2, nrmframe2 / nframesamples, writepos);
    nfilled = min(256, filled + 1);
    nhop = hop + 1;
    // Ring guard covers the full window, both delay signs and all search lags.
    if ((nfilled >= 64 + max(rdelay, mdelay)) && (nhop >= 10)) {
        nwindowscomputed = min(1000000000, windowscomputed + 1);
        bestmatch = -1;
        bestmic = 0;
        bestref = 0;
        bestactivity = 0;
        bestvariation = 0;
        bestbands = 0;
        peakviewmatch = 0;
        bestband0 = 0; bestband1 = 0; bestband2 = 0;
        // Fixed reference views only. A good match can also contain other
        // sounds; a poor match does not establish an independent source.
        for (model = 0; model < 4; model = model + 1) {
        // 5 hypotheses in ENVELOPE frames. This is not a delay estimator.
        for (lag = -2; lag <= 2; lag = lag + 1) {
            weighted = 0;
            weight = 0;
            micmean = 0;
            refmean = 0;
            micvariation = 0;
            bands = 0;
            activeframes = 0;
            jexceed0 = 0; jexceed1 = 0; jexceed2 = 0;
            sx0 = 0; sy0 = 0; sxx0 = 0; syy0 = 0; sxy0 = 0;
            sx1 = 0; sy1 = 0; sxx1 = 0; syy1 = 0; sxy1 = 0;
            sx2 = 0; sy2 = 0; sxx2 = 0; syy2 = 0; sxy2 = 0;
            for (k = 0; k < 60; k = k + 1) {
                mi = writepos - 2 - mdelay - k;
                ri = writepos - 2 - rdelay - lag - k;
                mi = mi < 0 ? mi + 256 : mi;
                ri = ri < 0 ? ri + 256 : ri;
                micframe = 0;
                x0 = peek(mdata0, mi);
                jexceed0 = jexceed0 + (x0 > bgcmplimit0);
                y0 = model == 0 ? peek(rdata0, ri) : (model == 1 ? peek(rmono0, ri) : (model == 2 ? peek(rleft0, ri) : peek(rright0, ri)));
                sx0 = sx0 + x0; sy0 = sy0 + y0;
                sxx0 = sxx0 + x0 * x0; syy0 = syy0 + y0 * y0;
                sxy0 = sxy0 + x0 * y0;
                micframe = micframe + x0;
                x1 = peek(mdata1, mi);
                jexceed1 = jexceed1 + (x1 > bgcmplimit1);
                y1 = model == 0 ? peek(rdata1, ri) : (model == 1 ? peek(rmono1, ri) : (model == 2 ? peek(rleft1, ri) : peek(rright1, ri)));
                sx1 = sx1 + x1; sy1 = sy1 + y1;
                sxx1 = sxx1 + x1 * x1; syy1 = syy1 + y1 * y1;
                sxy1 = sxy1 + x1 * y1;
                micframe = micframe + x1;
                x2 = peek(mdata2, mi);
                jexceed2 = jexceed2 + (x2 > bgcmplimit2);
                y2 = model == 0 ? peek(rdata2, ri) : (model == 1 ? peek(rmono2, ri) : (model == 2 ? peek(rleft2, ri) : peek(rright2, ri)));
                sx2 = sx2 + x2; sy2 = sy2 + y2;
                sxx2 = sxx2 + x2 * x2; syy2 = syy2 + y2 * y2;
                sxy2 = sxy2 + x2 * y2;
                micframe = micframe + x2;
                activeframes = activeframes + (micframe >= 0.004);
            }
            vx0 = max(0, sxx0 - sx0 * sx0 / 60);
            vy0 = max(0, syy0 - sy0 * sy0 / 60);
            cov0 = max(0, sxy0 - sx0 * sy0 / 60);
            varied0 = (vx0 > max(0.00000001, sx0 * sx0 / 60 * 0.01)) && (vy0 > max(0.00000001, sy0 * sy0 / 60 * 0.01));
            usable0 = varied0 && (sx0 / 60 >= 0.0003) && (sy0 / 60 >= 0.0001);
            score0 = clamp(cov0 * cov0 / max(0.000000000000000000000001, vx0 * vy0), 0, 1);
            weighted = weighted + (usable0 ? score0 * vx0 : 0);
            weight = weight + (usable0 ? vx0 : 0);
            micmean = micmean + sx0 / 60;
            refmean = refmean + sy0 / 60;
            micvariation = micvariation + vx0 / 60;
            bands = bands + usable0;
            vx1 = max(0, sxx1 - sx1 * sx1 / 60);
            vy1 = max(0, syy1 - sy1 * sy1 / 60);
            cov1 = max(0, sxy1 - sx1 * sy1 / 60);
            varied1 = (vx1 > max(0.00000001, sx1 * sx1 / 60 * 0.01)) && (vy1 > max(0.00000001, sy1 * sy1 / 60 * 0.01));
            usable1 = varied1 && (sx1 / 60 >= 0.0003) && (sy1 / 60 >= 0.0001);
            score1 = clamp(cov1 * cov1 / max(0.000000000000000000000001, vx1 * vy1), 0, 1);
            weighted = weighted + (usable1 ? score1 * vx1 : 0);
            weight = weight + (usable1 ? vx1 : 0);
            micmean = micmean + sx1 / 60;
            refmean = refmean + sy1 / 60;
            micvariation = micvariation + vx1 / 60;
            bands = bands + usable1;
            vx2 = max(0, sxx2 - sx2 * sx2 / 60);
            vy2 = max(0, syy2 - sy2 * sy2 / 60);
            cov2 = max(0, sxy2 - sx2 * sy2 / 60);
            varied2 = (vx2 > max(0.00000001, sx2 * sx2 / 60 * 0.01)) && (vy2 > max(0.00000001, sy2 * sy2 / 60 * 0.01));
            usable2 = varied2 && (sx2 / 60 >= 0.0003) && (sy2 / 60 >= 0.0001);
            score2 = clamp(cov2 * cov2 / max(0.000000000000000000000001, vx2 * vy2), 0, 1);
            weighted = weighted + (usable2 ? score2 * vx2 : 0);
            weight = weight + (usable2 ? vx2 : 0);
            micmean = micmean + sx2 / 60;
            refmean = refmean + sy2 / 60;
            micvariation = micvariation + vx2 / 60;
            bands = bands + usable2;
            score = weight > 0 ? weighted / weight : 0;
            if (model == 0) { peakviewmatch = max(peakviewmatch, score); }
            if (score > bestmatch) {
                bestmatch = score;
                bestmic = micmean;
                bestref = refmean;
                bestactivity = activeframes / 60;
                bestvariation = micvariation / max(0.00000001, micmean * micmean);
                bestbands = bands;
                bestband0 = usable0 ? score0 : 0;
                bestband1 = usable1 ? score1 : 0;
                bestband2 = usable2 ? score2 : 0;
                nmodel = model;
                nlagms = lag * framems;
                nband_input_level_low = sx0 / 60;
                nband_reference_level_low = sy0 / 60;
                nband_input_variation_low = vx0 / max(0.000000000001, sx0 * sx0 / 60);
                nband_reference_variation_low = vy0 / max(0.000000000001, sy0 * sy0 / 60);
                nband_weight_low = usable0 ? vx0 / max(0.000000000000000000000001, weight) : 0;
                nband_input_level_mid = sx1 / 60;
                nband_reference_level_mid = sy1 / 60;
                nband_input_variation_mid = vx1 / max(0.000000000001, sx1 * sx1 / 60);
                nband_reference_variation_mid = vy1 / max(0.000000000001, sy1 * sy1 / 60);
                nband_weight_mid = usable1 ? vx1 / max(0.000000000000000000000001, weight) : 0;
                nband_input_level_high = sx2 / 60;
                nband_reference_level_high = sy2 / 60;
                nband_input_variation_high = vx2 / max(0.000000000001, sx2 * sx2 / 60);
                nband_reference_variation_high = vy2 / max(0.000000000001, sy2 * sy2 / 60);
                nband_weight_high = usable2 ? vx2 / max(0.000000000000000000000001, weight) : 0;
                nusable_band_mask = usable0 + 2 * usable1 + 4 * usable2;
                nreference_supported_band_mask = (usable0 && (score0 > 0.50)) + 2 * (usable1 && (score1 > 0.50)) + 4 * (usable2 && (score2 > 0.50));
            }
        }
        }
        ninputlevel = bestmic;
        nreflevel = bestref;
        nactivity = bestactivity;
        nmatch = max(0, bestmatch);
        nbandmatch0 = bestband0;
        nbandmatch1 = bestband1;
        nbandmatch2 = bestband2;
        nusablebands = bestbands;
        nmicvariationindex = bestvariation;
        npeakmatch = peakviewmatch;
        // Pack only small exact integers into THREE extra telemetry ports.
        // Categories: 1 within quiet limits; 2 intermittent; 3 persistent
        // with reference support; 4 persistent low resemblance but usable;
        // 5 persistent with unusable reference evidence. No category is voice.
        jend = clock - (2 + mdelay) * framelen;
        jstart = jend - 60 * framelen + 1;
        if ((nbgstate == 2) && (jstart > njointbaselineend)) {
            jusable0 = floor(nusable_band_mask / 1) - 2 * floor(nusable_band_mask / 2);
            jsupported0 = floor(nreference_supported_band_mask / 1) - 2 * floor(nreference_supported_band_mask / 2);
            jcode0 = jexceed0 <= 6 ? 1 : (jexceed0 < 36 ? 2 : (jsupported0 ? 3 : (jusable0 ? 4 : 5)));
            jusable1 = floor(nusable_band_mask / 2) - 2 * floor(nusable_band_mask / 4);
            jsupported1 = floor(nreference_supported_band_mask / 2) - 2 * floor(nreference_supported_band_mask / 4);
            jcode1 = jexceed1 <= 6 ? 1 : (jexceed1 < 36 ? 2 : (jsupported1 ? 3 : (jusable1 ? 4 : 5)));
            jusable2 = floor(nusable_band_mask / 4) - 2 * floor(nusable_band_mask / 8);
            jsupported2 = floor(nreference_supported_band_mask / 4) - 2 * floor(nreference_supported_band_mask / 8);
            jcode2 = jexceed2 <= 6 ? 1 : (jexceed2 < 36 ? 2 : (jsupported2 ? 3 : (jusable2 ? 4 : 5)));
            njointend = jend;
            njointcodes = jcode0 + 8 * jcode1 + 64 * jcode2;
            njointcounts = jexceed0 + 64 * jexceed1 + 4096 * jexceed2;
        } else { njointend = 0; njointcodes = 0; njointcounts = 0; }
        // This index is unexplained envelope VARIATION, not residual audio,
        // SNR, voice probability, or a calibrated confidence score.
        ndistinct = bestbands >= 2 ? 1 - nmatch : 0;
        rawclass = 7;
        if (bestref < 0.0004) { rawclass = 4; }
        else if ((bestmic < 0.004) || (bestactivity < 0.20)) { rawclass = 3; }
        else if ((bestbands >= 2) && (nmatch >= 0.72)) { rawclass = 5; }
        // Preserve uncertainty if any usable band still follows the reference.
        // Class 6 means only LOW resemblance, never proven distinct sound.
        else if ((bestbands >= 2) && (nmatch <= 0.35) && (max(bestband0, max(bestband1, bestband2)) <= 0.50) && (bestvariation >= 0.05) && (bestactivity >= 0.50)) { rawclass = 6; }
        // Explain the previous uncertainty veto without claiming a source or
        // discarding the other bands. No threshold or matching score changes.
        else if ((bestbands >= 2) && (max(bestband0, max(bestband1, bestband2)) > 0.50)) { rawclass = 10; }
        nclassrun = rawclass == lastclass ? min(3, classrun + 1) : 1;
        nlastclass = rawclass;
        // Stabilize claims across three overlapping windows. These are not
        // independent experiments; counters are diagnostic observations only.
        nstate = ((rawclass == 5) || (rawclass == 6) || (rawclass == 10)) && (nclassrun < 3) ? 7 : rawclass;
        npartial_reference_windows = min(1000000000, partial_reference_windows + (nstate == 10));
        nband_reference_windows_low = min(1000000000, band_reference_windows_low + ((rawclass != 3) && (rawclass != 4) && (bestband0 > 0.50)));
        nband_reference_windows_mid = min(1000000000, band_reference_windows_mid + ((rawclass != 3) && (rawclass != 4) && (bestband1 > 0.50)));
        nband_reference_windows_high = min(1000000000, band_reference_windows_high + ((rawclass != 3) && (rawclass != 4) && (bestband2 > 0.50)));
        nreferencewindows = referencewindows + (nstate == 5);
        ndistinctwindows = distinctwindows + (nstate == 6);
        nuncertainwindows = uncertainwindows + (nstate == 7);
        nhop = 0;
    }
    nwritepos = writepos >= 255 ? 0 : writepos + 1;
    nframesamples = 0;
    nmsum0 = 0;
    nrsum0 = 0;
    nmsum1 = 0;
    nrsum1 = 0;
    nmsum2 = 0;
    nrsum2 = 0;
    nrlframe0 = 0; nrlframe1 = 0; nrlframe2 = 0;
    nrrframe0 = 0; nrrframe1 = 0; nrrframe2 = 0;
    nrmframe0 = 0; nrmframe1 = 0; nrmframe2 = 0;
}
// Only a newly completed one-second comparison can update a phase.
// The existing comparison path and its first 86 outputs are not modified.
if (!resetnow && !bgnewrequest && (nbgstate == 2)) {
    if (bgstate == 1) { ntestphase = 1; }
    testwindowstart = clock - nbgcmpframes * framelen + 1;
    if (nbgcmpwindows > bgcmpwindows) {
        if (ntestphase == 1) {
            nmutedwindows = mutedwindows + 1;
            nmutedwithin = mutedwithin + (nbgcmpstate == 2);
            nmutedabove = mutedabove + (nbgcmpstate == 3);
            nmuteduncertain = muteduncertain + (nbgcmpstate == 4);
            nmutedstart = mutedwindows == 0 ? testwindowstart : mutedstart;
            nmutedend = clock;
            nmutedmean0 = mutedmean0 + (nbgcmplevel0 - mutedmean0) / nmutedwindows;
            nmutedfraction0 = mutedfraction0 + (nbgcmpfraction0 - mutedfraction0) / nmutedwindows;
            nmutedbandwindows0 = mutedbandwindows0 + (nbgcmpfraction0 >= 0.6);
            nmutedmean1 = mutedmean1 + (nbgcmplevel1 - mutedmean1) / nmutedwindows;
            nmutedfraction1 = mutedfraction1 + (nbgcmpfraction1 - mutedfraction1) / nmutedwindows;
            nmutedbandwindows1 = mutedbandwindows1 + (nbgcmpfraction1 >= 0.6);
            nmutedmean2 = mutedmean2 + (nbgcmplevel2 - mutedmean2) / nmutedwindows;
            nmutedfraction2 = mutedfraction2 + (nbgcmpfraction2 - mutedfraction2) / nmutedwindows;
            nmutedbandwindows2 = mutedbandwindows2 + (nbgcmpfraction2 >= 0.6);
            if (nmutedwindows >= 10) { ntestphase = 2; }
        }
        if ((ntestphase == 4) && (testwindowstart >= ntestgate)) {
            naudiblewindows = audiblewindows + 1;
            naudiblewithin = audiblewithin + (nbgcmpstate == 2);
            naudibleabove = audibleabove + (nbgcmpstate == 3);
            naudibleuncertain = audibleuncertain + (nbgcmpstate == 4);
            naudiblestart = audiblewindows == 0 ? testwindowstart : audiblestart;
            naudibleend = clock;
            naudiblemean0 = audiblemean0 + (nbgcmplevel0 - audiblemean0) / naudiblewindows;
            naudiblefraction0 = audiblefraction0 + (nbgcmpfraction0 - audiblefraction0) / naudiblewindows;
            naudiblebandwindows0 = audiblebandwindows0 + (nbgcmpfraction0 >= 0.6);
            naudiblemean1 = audiblemean1 + (nbgcmplevel1 - audiblemean1) / naudiblewindows;
            naudiblefraction1 = audiblefraction1 + (nbgcmpfraction1 - audiblefraction1) / naudiblewindows;
            naudiblebandwindows1 = audiblebandwindows1 + (nbgcmpfraction1 >= 0.6);
            naudiblemean2 = audiblemean2 + (nbgcmplevel2 - audiblemean2) / naudiblewindows;
            naudiblefraction2 = audiblefraction2 + (nbgcmpfraction2 - audiblefraction2) / naudiblewindows;
            naudiblebandwindows2 = audiblebandwindows2 + (nbgcmpfraction2 >= 0.6);
