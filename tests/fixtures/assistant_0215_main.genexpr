offsetchanged = abs(in7 - lastoffset) > 0.000001;
profilechanged = profilevalid != lastprofile;
modechanged = sourcemode != lastmode;
changed = epochchanged || offsetchanged || profilechanged || modechanged;
peak = max(max(abs(in1), abs(in2)), max(abs(in3), abs(in4)));
ncliphold = peak >= 0.98 ? samplerate * 0.250 : max(0, cliphold - 1);
resetnow = !operating || changed || (ncliphold > 0);
reason = (in5 != 1) + 2 * epochchanged + 4 * offsetchanged + 8 * (profilevalid != 1 || profilechanged) + 16 * (sourcemode != 1 || modechanged) + 32 * (ncliphold > 0);
nrunlength = resetnow ? 0 : min(runlength + 1, 1000000000);
nlongestrun = max(longestrun, nrunlength);
nresetepisodes = min(1000000000, resetepisodes + (resetnow && !previousreset));
nlastreason = resetnow ? reason : lastreason;
nwindowscomputed = windowscomputed;
nepochchanges = min(1000000000, epochchanges + epochchanged);
noffsetchanges = min(1000000000, offsetchanges + offsetchanged);
npermitlosses = min(1000000000, permitlosses + ((in5 != 1) && (lastpermit == 1)));
nprofilechanges = min(1000000000, profilechanges + profilechanged);
nmodechanges = min(1000000000, modechanges + modechanged);
// Smooth DC rejection and broad bands, independently per stereo channel.
c20 = exp(-6.28318530718 * 20 / samplerate);
c400 = exp(-6.28318530718 * 400 / samplerate);
c1800 = exp(-6.28318530718 * 1800 / samplerate);
nmldc = in1 + c20 * (mldc - in1);
mlhp = in1 - nmldc;
nmllow = mlhp + c400 * (mllow - mlhp);
nmlupper = mlhp + c1800 * (mlupper - mlhp);
nmrdc = in2 + c20 * (mrdc - in2);
mrhp = in2 - nmrdc;
nmrlow = mrhp + c400 * (mrlow - mrhp);
nmrupper = mrhp + c1800 * (mrupper - mrhp);
nrldc = in3 + c20 * (rldc - in3);
rlhp = in3 - nrldc;
nrllow = rlhp + c400 * (rllow - rlhp);
nrlupper = rlhp + c1800 * (rlupper - rlhp);
nrrdc = in4 + c20 * (rrdc - in4);
rrhp = in4 - nrrdc;
nrrlow = rrhp + c400 * (rrlow - rrhp);
nrrupper = rrhp + c1800 * (rrupper - rrhp);
// Mix before rectification: summing envelopes would miss stereo cancellation.
rm = (in3 + in4) * 0.5;
nrmdc = rm + c20 * (rmdc - rm);
rmhp = rm - nrmdc;
nrmlow = rmhp + c400 * (rmlow - rmhp);
nrmupper = rmhp + c1800 * (rmupper - rmhp);
nrlframe0 = rlframe0 + abs(nrllow);
nrlframe1 = rlframe1 + abs(nrlupper - nrllow);
nrlframe2 = rlframe2 + abs(rlhp - nrlupper);
nrrframe0 = rrframe0 + abs(nrrlow);
nrrframe1 = rrframe1 + abs(nrrupper - nrrlow);
nrrframe2 = rrframe2 + abs(rrhp - nrrupper);
nrmframe0 = rmframe0 + abs(nrmlow);
nrmframe1 = rmframe1 + abs(nrmupper - nrmlow);
nrmframe2 = rmframe2 + abs(rmhp - nrmupper);
nmsum0 = msum0 + max(abs(nmllow), abs(nmrlow));
nmsum1 = msum1 + max(abs(nmlupper - nmllow), abs(nmrupper - nmrlow));
nmsum2 = msum2 + max(abs(mlhp - nmlupper), abs(mrhp - nmrupper));
nrsum0 = rsum0 + max(abs(nrllow), abs(nrrlow));
nrsum1 = rsum1 + max(abs(nrlupper - nrllow), abs(nrrupper - nrrlow));
nrsum2 = rsum2 + max(abs(rlhp - nrlupper), abs(rrhp - nrrupper));
nframesamples = framesamples + 1;
nwritepos = writepos;
nfilled = filled;
nhop = hop;
nstate = state;
nmatch = match;
ndistinct = distinct;
ninputlevel = inputlevel;
nreflevel = reflevel;
nactivity = activity;
nmodel = bestmodel;
nlagms = bestlagms;
nbandmatch0 = bandmatch0;
nbandmatch1 = bandmatch1;
nbandmatch2 = bandmatch2;
nusablebands = usablebands;
nmicvariationindex = micvariationindex;
npeakmatch = peakmatch;
nband_input_level_low = band_input_level_low;
nband_input_level_mid = band_input_level_mid;
nband_input_level_high = band_input_level_high;
nband_reference_level_low = band_reference_level_low;
nband_reference_level_mid = band_reference_level_mid;
nband_reference_level_high = band_reference_level_high;
nband_input_variation_low = band_input_variation_low;
nband_input_variation_mid = band_input_variation_mid;
nband_input_variation_high = band_input_variation_high;
nband_reference_variation_low = band_reference_variation_low;
nband_reference_variation_mid = band_reference_variation_mid;
