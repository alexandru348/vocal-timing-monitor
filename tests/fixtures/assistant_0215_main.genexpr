    ntestgate = 0;
    nmutedwindows = 0;
    nmutedwithin = 0;
    nmutedabove = 0;
    nmuteduncertain = 0;
    nmutedstart = 0;
    nmutedend = 0;
    nmutedmean0 = 0;
    nmutedfraction0 = 0;
    nmutedbandwindows0 = 0;
    nmutedmean1 = 0;
    nmutedfraction1 = 0;
    nmutedbandwindows1 = 0;
    nmutedmean2 = 0;
    nmutedfraction2 = 0;
    nmutedbandwindows2 = 0;
    naudiblewindows = 0;
    naudiblewithin = 0;
    naudibleabove = 0;
    naudibleuncertain = 0;
    naudiblestart = 0;
    naudibleend = 0;
    naudiblemean0 = 0;
    naudiblefraction0 = 0;
    naudiblebandwindows0 = 0;
    naudiblemean1 = 0;
    naudiblefraction1 = 0;
    naudiblebandwindows1 = 0;
