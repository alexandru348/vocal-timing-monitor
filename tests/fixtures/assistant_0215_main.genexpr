// Background fields stay separate from current comparison evidence.
out55 = nbgstate;
out56 = nbgrequest;
out57 = nbgcount;
out58 = nbgcount * framelen * 1000 / samplerate;
out59 = nbgmean0;
out60 = nbgmean1;
out61 = nbgmean2;
out62 = max(0, nbgm20 / max(1, nbgcount));
out63 = max(0, nbgm21 / max(1, nbgcount));
out64 = max(0, nbgm22 / max(1, nbgcount));
// Independent completed comparison window, never a voice/SNR estimate.
out65 = nbgcmpstate;
out66 = nbgcmpframes;
out67 = nbgcmpframes * framelen * 1000 / samplerate;
out68 = nbgcmpwindows;
out69 = nbgcmpmask;
out70 = nbgcmpend;
out71 = nbgcmplevel0;
out72 = nbgcmplevel1;
out73 = nbgcmplevel2;
out74 = nbgstate == 2 ? bgcmplimit0 : 0;
out75 = nbgstate == 2 ? bgcmplimit1 : 0;
out76 = nbgstate == 2 ? bgcmplimit2 : 0;
out77 = nbgcmpfraction0;
out78 = nbgcmpfraction1;
out79 = nbgcmpfraction2;
out80 = nbgcmpframes > 0 ? (nbgmean0 > 0.00000001) + 2 * (nbgmean1 > 0.00000001) + 4 * (nbgmean2 > 0.00000001) : 0;
out81 = (nbgcmpframes > 0) && (nbgmean0 > 0.00000001) ? nbgcmplevel0 / max(0.00000001, nbgmean0) : 0;
out82 = (nbgcmpframes > 0) && (nbgmean1 > 0.00000001) ? nbgcmplevel1 / max(0.00000001, nbgmean1) : 0;
out83 = (nbgcmpframes > 0) && (nbgmean2 > 0.00000001) ? nbgcmplevel2 / max(0.00000001, nbgmean2) : 0;
out84 = nbgcmpwithin;
out85 = nbgcmpabove;
out86 = nbgcmpuncertain;
// Phase summaries are frozen on completion and revoked on context loss.
out87 = ntestphase;
out88 = ntestrequest;
out89 = ntestgate;
out90 = (nmutedwindows >= 10) + 2 * (naudiblewindows >= 20);
out91 = nmutedwindows;
out92 = nmutedwindows * nbgcmpframes * framelen * 1000 / samplerate;
out93 = nmutedwithin;
out94 = nmutedabove;
out95 = nmuteduncertain;
out96 = nmutedstart;
