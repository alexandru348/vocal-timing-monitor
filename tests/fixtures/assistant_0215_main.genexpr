    nband_reference_level_low = 0;
    nband_reference_level_mid = 0;
    nband_reference_level_high = 0;
    nband_input_variation_low = 0;
    nband_input_variation_mid = 0;
    nband_input_variation_high = 0;
    nband_reference_variation_low = 0;
    nband_reference_variation_mid = 0;
    nband_reference_variation_high = 0;
    nband_weight_low = 0;
    nband_weight_mid = 0;
    nband_weight_high = 0;
    nusable_band_mask = 0;
    nreference_supported_band_mask = 0;
    npartial_reference_windows = 0;
    nband_reference_windows_low = 0;
    nband_reference_windows_mid = 0;
    nband_reference_windows_high = 0;
    nlastclass = 0;
    nclassrun = 0;
    nreferencewindows = 0;
    ndistinctwindows = 0;
    nuncertainwindows = 0;
    nmsum0 = 0;
    nrsum0 = 0;
    nmsum1 = 0;
    nrsum1 = 0;
    nmsum2 = 0;
    nrsum2 = 0;
    nmldc = 0;
    nmllow = 0;
    nmlupper = 0;
    nmrdc = 0;
    nmrlow = 0;
    nmrupper = 0;
    nrldc = 0;
    nrllow = 0;
    nrlupper = 0;
    nrrdc = 0;
    nrrlow = 0;
    nrrupper = 0;
    nrmdc = 0;
    nrmlow = 0;
    nrmupper = 0;
    nrlframe0 = 0; nrlframe1 = 0; nrlframe2 = 0;
