if (ncliphold > 0) { outstate = 2; }
else if (in5 != 1) { outstate = 0; }
else if (sourcemode != 1) { outstate = 9; }
else if (profilevalid != 1) { outstate = 8; }
out1 = outstate;
out2 = nmatch;
out3 = ndistinct;
out4 = ninputlevel;
out5 = nreflevel;
out6 = nfilled >= 64 + max(rdelay, mdelay) ? 60 * framems : 0;
out7 = nactivity;
out8 = in6;
// Deliberately never promote quality: unrelated sound can also be noise.
out9 = 0;
out10 = nreferencewindows;
out11 = ndistinctwindows;
out12 = nuncertainwindows;
// Diagnostic histories below span contexts; they are not current evidence.
out13 = nfilled;
out14 = nframesamples;
out15 = nrunlength * 1000 / samplerate;
out16 = nlongestrun * 1000 / samplerate;
out17 = nlastreason;
out18 = nresetepisodes;
