    nwritepos = 0;
    nfilled = 0;
    nhop = 0;
    nstate = 1;
    nmatch = 0;
    ndistinct = 0;
    ninputlevel = 0;
    nreflevel = 0;
    nactivity = 0;
    nmodel = 0;
    nlagms = 0;
    nbandmatch0 = 0;
    nbandmatch1 = 0;
    nbandmatch2 = 0;
    nusablebands = 0;
    nmicvariationindex = 0;
    npeakmatch = 0;
    nband_input_level_low = 0;
    nband_input_level_mid = 0;
