nclassrun = classrun;
nreferencewindows = referencewindows;
ndistinctwindows = distinctwindows;
nuncertainwindows = uncertainwindows;
// The background profile is session/context-scoped and diagnostic only.
// Starting a new request discards the partial leading 10 ms frame and waits
// at least 500 ms so the button click is not part of the declared baseline.
framelen = max(1, floor(samplerate * 0.010));
nbgstate = bgstate;
nbgrequest = bgrequest;
nbgcount = bgcount;
nbgskipframe = bgskipframe;
nbgmean0 = bgmean0;
nbgmean1 = bgmean1;
nbgmean2 = bgmean2;
nbgm20 = bgm20;
nbgm21 = bgm21;
nbgm22 = bgm22;
nbgcmpstate = bgcmpstate;
nbgcmpcount = bgcmpcount;
nbgcmpframes = bgcmpframes;
nbgcmpwindows = bgcmpwindows;
nbgcmpmask = bgcmpmask;
nbgcmpend = bgcmpend;
nbgcmpwithin = bgcmpwithin;
nbgcmpabove = bgcmpabove;
nbgcmpuncertain = bgcmpuncertain;
nbgcmpsum0 = bgcmpsum0;
nbgcmpexceed0 = bgcmpexceed0;
nbgcmplevel0 = bgcmplevel0;
nbgcmpfraction0 = bgcmpfraction0;
nbgcmpsum1 = bgcmpsum1;
nbgcmpexceed1 = bgcmpexceed1;
nbgcmplevel1 = bgcmplevel1;
nbgcmpfraction1 = bgcmpfraction1;
nbgcmpsum2 = bgcmpsum2;
nbgcmpexceed2 = bgcmpexceed2;
nbgcmplevel2 = bgcmplevel2;
nbgcmpfraction2 = bgcmpfraction2;
// Joint observations use the SAME microphone frames as reference matching.
// Their fixed quiet baseline is never adapted to later loud sounds.
njointbaselineend = jointbaselineend;
njointend = jointend;
njointcodes = jointcodes;
njointcounts = jointcounts;
bgnewrequest = backgroundrequest != bgrequest;
if (resetnow || bgnewrequest) {
    njointbaselineend = 0; njointend = 0; njointcodes = 0; njointcounts = 0;
}
if (bgnewrequest) {
    nbgstate = backgroundrequest > 0 ? 1 : 0;
    nbgrequest = backgroundrequest;
    nbgcount = 0;
    nbgskipframe = 1 + floor(samplerate * 0.5 / framelen + 0.999999999);
    nbgmean0 = 0;
    nbgmean1 = 0;
    nbgmean2 = 0;
    nbgm20 = 0;
    nbgm21 = 0;
    nbgm22 = 0;
}
if (resetnow) {
    nbgstate = (bgstate != 0 || bgnewrequest) ? 3 : 0;
    nbgcount = 0;
    nbgskipframe = 0;
    nbgmean0 = 0;
    nbgmean1 = 0;
    nbgmean2 = 0;
    nbgm20 = 0;
    nbgm21 = 0;
    nbgm22 = 0;
}
// Heuristic limits on the SAME disjoint 10 ms envelopes as acquisition.
// Three population SDs is a margin, NOT a confidence interval or voice test.
// Relative/absolute floors avoid hypersensitivity to constant/zero baselines.
bgcmplimit0 = nbgmean0 + max(0.00001, max(0.1 * nbgmean0, 3 * sqrt(max(0, nbgm20 / max(1, nbgcount)))));
bgcmplimit1 = nbgmean1 + max(0.00001, max(0.1 * nbgmean1, 3 * sqrt(max(0, nbgm21 / max(1, nbgcount)))));
bgcmplimit2 = nbgmean2 + max(0.00001, max(0.1 * nbgmean2, 3 * sqrt(max(0, nbgm22 / max(1, nbgcount)))));
if (resetnow || bgnewrequest || (nbgstate != 2)) {
    nbgcmpstate = 0;
    nbgcmpcount = 0;
    nbgcmpframes = 0;
    nbgcmpwindows = 0;
    nbgcmpmask = 0;
    nbgcmpend = 0;
    nbgcmpwithin = 0;
    nbgcmpabove = 0;
    nbgcmpuncertain = 0;
    nbgcmpsum0 = 0;
    nbgcmpexceed0 = 0;
    nbgcmplevel0 = 0;
    nbgcmpfraction0 = 0;
    nbgcmpsum1 = 0;
    nbgcmpexceed1 = 0;
    nbgcmplevel1 = 0;
    nbgcmpfraction1 = 0;
    nbgcmpsum2 = 0;
    nbgcmpexceed2 = 0;
    nbgcmplevel2 = 0;
    nbgcmpfraction2 = 0;
}
// Separate declared-condition phases. No mute inference and no timed
