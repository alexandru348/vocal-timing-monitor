ntestphase = testphase;
ntestrequest = testrequest;
ntestgate = testgate;
nmutedwindows = mutedwindows;
nmutedwithin = mutedwithin;
nmutedabove = mutedabove;
nmuteduncertain = muteduncertain;
nmutedstart = mutedstart;
nmutedend = mutedend;
nmutedmean0 = mutedmean0;
nmutedfraction0 = mutedfraction0;
nmutedbandwindows0 = mutedbandwindows0;
nmutedmean1 = mutedmean1;
nmutedfraction1 = mutedfraction1;
nmutedbandwindows1 = mutedbandwindows1;
nmutedmean2 = mutedmean2;
nmutedfraction2 = mutedfraction2;
nmutedbandwindows2 = mutedbandwindows2;
naudiblewindows = audiblewindows;
naudiblewithin = audiblewithin;
naudibleabove = audibleabove;
naudibleuncertain = audibleuncertain;
naudiblestart = audiblestart;
naudibleend = audibleend;
naudiblemean0 = audiblemean0;
naudiblefraction0 = audiblefraction0;
naudiblebandwindows0 = audiblebandwindows0;
naudiblemean1 = audiblemean1;
naudiblefraction1 = audiblefraction1;
naudiblebandwindows1 = audiblebandwindows1;
naudiblemean2 = audiblemean2;
naudiblefraction2 = audiblefraction2;
naudiblebandwindows2 = audiblebandwindows2;
testnewrequest = speakersrequest != testrequest;
ntestrequest = speakersrequest;
